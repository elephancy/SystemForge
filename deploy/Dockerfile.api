FROM node:26-trixie-slim AS toolchain
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.16.0 --activate
WORKDIR /workspace

FROM toolchain AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/sim-core/package.json packages/sim-core/package.json
RUN pnpm install --frozen-lockfile
COPY apps/api apps/api
COPY packages/contracts packages/contracts
COPY packages/sim-core packages/sim-core
RUN pnpm --filter @systemforge/api build

FROM toolchain AS production-dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/sim-core/package.json packages/sim-core/package.json
RUN pnpm install --prod --frozen-lockfile --filter @systemforge/api...

FROM node:26-trixie-slim
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update \
  && apt-get upgrade -y \
  && rm -rf /var/lib/apt/lists/* \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx
COPY --from=production-dependencies /workspace/node_modules /app/node_modules
COPY --from=production-dependencies /workspace/apps/api/node_modules /app/apps/api/node_modules
COPY --from=dependencies /workspace/apps/api/dist /app/apps/api/dist
COPY apps/api/migrations /app/apps/api/migrations
COPY scripts/production_smoke.mjs /app/apps/api/production_smoke.mjs
COPY scripts/overload_smoke.mjs /app/apps/api/overload_smoke.mjs
USER node
EXPOSE 8080
CMD ["node", "apps/api/dist/index.js"]
