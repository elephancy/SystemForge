{
  "name": "systemforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @systemforge/web dev",
    "dev:api": "pnpm --filter @systemforge/api dev",
    "dev:worker": "pnpm --filter @systemforge/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"apps/**/*.{ts,tsx,mjs}\" \"packages/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.config.{mjs,ts}\" --max-warnings=0",
    "test": "vitest run --exclude packages/sim-core/tests/simulate.performance.test.ts",
    "test:coverage": "vitest run --coverage --exclude packages/sim-core/tests/simulate.performance.test.ts",
    "test:mutations": "node scripts/run-targeted-mutations.mjs",
    "test:stability": "node scripts/run-test-stability.mjs",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "test:ui": "playwright test",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "typecheck": "tsc -b --pretty false",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:performance && pnpm build && pnpm --filter @systemforge/web test:sites"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
